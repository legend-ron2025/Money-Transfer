# Sentry
SENTRY_DSN="${SENTRY_DSN}"

# FCM
FCM_SERVER_KEY="${FCM_SERVER_KEY}"

# Play Integrity
PLAY_INTEGRITY_API_KEY="${PLAY_INTEGRITY_API_KEY}"