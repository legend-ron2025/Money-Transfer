<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="encrypted_prefs.xml" />
        <exclude domain="sharedpref" path="auth.xml" />
        <exclude domain="database"   path="moneytracker.db" />
        <exclude domain="database"   path="moneytracker.db-wal" />
        <exclude domain="database"   path="moneytracker.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="encrypted_prefs.xml" />
        <exclude domain="database"   path="moneytracker.db" />
    </device-transfer>
</data-extraction-rules>
