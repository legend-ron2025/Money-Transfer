# Database
DATABASE_URL="postgresql://moneytracker:password@localhost:5432/moneytracker"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Account Aggregator
AA_CLIENT_ID="your-aa-client-id"
AA_CLIENT_SECRET="your-aa-client-secret"
AA_BASE_URL="https://aa-sandbox.example.com"

# Encryption
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# Firebase
FIREBASE_PROJECT_ID="your-firebase-project"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# Sentry
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"

# FCM
FCM_SERVER_KEY="your-fcm-server-key"

# Play Integrity
PLAY_INTEGRITY_API_KEY="your-play-integrity-api-key"