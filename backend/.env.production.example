# ── MoneyTracker Backend — Production Environment Variables ──────────────────
# Add these in Railway / Render / your hosting provider dashboard.
# NEVER commit real values to git.

# ── Database (Railway PostgreSQL plugin adds this automatically) ──────────────
DATABASE_URL=postgresql://user:password@host:5432/moneytracker

# ── Redis (Railway Redis plugin adds this automatically) ─────────────────────
REDIS_URL=redis://default:password@host:6379

# ── Auth — generate strong secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_generate_a_48_char_random_hex_string
JWT_REFRESH_SECRET=CHANGE_THIS_generate_a_different_48_char_random_hex_string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://moneytracker.vercel.app,https://moneytracker.app

# ── Setu Account Aggregator (register at aa-sandbox.setu.co) ─────────────────
SETU_AA_BASE_URL=https://aa.setu.co
SETU_AA_CLIENT_ID=your_setu_client_id
SETU_AA_CLIENT_SECRET=your_setu_client_secret
SETU_WEBHOOK_SECRET=your_setu_webhook_hmac_secret

# ── AA FIU RSA Private Key (PEM, generate with openssl) ──────────────────────
# openssl genrsa -out fiu-private.pem 2048
# Then paste the full PEM content (with newlines as \n) here
AA_FIU_PRIVATE_KEY=

# ── Firebase (from Firebase Console → Project Settings → Service Accounts) ───
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# ── Sentry (optional — from sentry.io) ───────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/project-id
