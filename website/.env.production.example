# ── MoneyTracker Website — Vercel Environment Variables ──────────────────────
# Add these in: Vercel Dashboard → Project → Settings → Environment Variables
# Set environment: Production (and Preview if needed)

# Your deployed backend URL (Railway / Render)
NEXT_PUBLIC_API_URL=https://moneytracker-api.railway.app

# Your Vercel deployment URL
NEXT_PUBLIC_SITE_URL=https://moneytracker.vercel.app

# App metadata (optional)
NEXT_PUBLIC_APP_NAME=MoneyTracker
NEXT_PUBLIC_APP_VERSION=1.0.0
